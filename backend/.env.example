# FastAPI & Core Settings
PROJECT_NAME="StackGPT - AI Financial Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="ai-stock-research-assistant-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT="development"  # Use "production" on Render

# Frontend Deployment URL
FRONTEND_URL="http://localhost:5173"  # Production: https://<YOUR-VERCEL-DOMAIN>.vercel.app

# Database Settings
# Local SQLite: sqlite:///./sql_app.db
# Render PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="sqlite:///./sql_app.db"

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"  # Production: https://<RENDER-BACKEND-URL>/api/v1/auth/google/callback

# Facebook OAuth Credentials (Optional)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/v1/auth/facebook/callback"

# CORS Settings (Comma separated array or string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","https://stackgpt.vercel.app","https://stackgpt-backend.onrender.com"]

# AI & Web Search API Keys (Optional)
OPENAI_API_KEY=""
WEB_SEARCH_API_KEY=""

