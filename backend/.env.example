# FastAPI Settings
PROJECT_NAME="AI Stock Research Assistant Backend"
API_V1_STR="/api/v1"
SECRET_KEY="ai-stock-research-assistant-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/stock_db
# Local PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/stock_db
# Local SQLite Fallback: sqlite:///./sql_app.db
DATABASE_URL="sqlite:///./sql_app.db"

# CORS Settings (Comma separated array or string)
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# AI & Web Search API Keys (Optional)
OPENAI_API_KEY=
WEB_SEARCH_API_KEY=
