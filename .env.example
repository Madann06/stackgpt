# ========================================================
# StackGPT — Environment Variables Example Configuration
# Copy this file to .env and fill in required values.
# ========================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock_db

# Database Connection URL (Docker PostgreSQL service name: postgres)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/stock_db

# FastAPI Core Settings
PROJECT_NAME="AI Stock Research Assistant Backend"
API_V1_STR="/api/v1"
SECRET_KEY="ai-stock-research-assistant-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://localhost"]

# AI Model Provider Credentials (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Financial Data & News API Credentials (Optional)
WEB_SEARCH_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
